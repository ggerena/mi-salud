# MiSalud — variables de entorno de desarrollo local.
# Todos los valores de este archivo son nombres de ejemplo; nunca ponga secretos
# ni datos reales aqui. Copie a .env (fuera de Git) y genere su propia clave.

# Entorno: development | test | production
NODE_ENV=development

# Direccion de escucha. Por defecto solo localhost.
HOST=127.0.0.1
PORT=8080

# Directorios de datos y objetos cifrados. En Windows/macOS no usar carpetas
# sincronizadas (Dropbox, OneDrive, Google Drive); en Linux evitar unidades de red.
MISALUD_DATA_DIR=./data
MISALUD_OBJECTS_DIR=./objects

# Limite del cuerpo de solicitudes en bytes (minimo 1024).
MISALUD_MAX_BODY_BYTES=10485760

# Nivel de log: debug | info | warn | error
MISALUD_LOG_LEVEL=info

# Clave maestra de 32 bytes en 64 caracteres hexadecimales. OBLIGATORIA.
# Genere una distinta por instalacion, por ejemplo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Alternativa: MISALUD_MASTER_KEY_FILE apuntando a un archivo montado fuera de Git.
# Defina UNA de las dos, nunca ambas. La siguiente es un nombre de ejemplo:
MISALUD_MASTER_KEY=
